      <div class="footer-container">
          <footer class="wrapper clearfix">

            <!-- LOGO Replace -->
            <h1>Dinesafe Toronto App</h1>

            <!-- INSERT Footer Links // Insert Desired menu items  -->
            <ul>
                <li><%= link_to "View on App Store", app_store_link, :target => "_blank", :onclick => onclick_conversion_track %></li>
                <li><%= link_to "Contact/Support", contact_path %></li>
                <li><%= link_to "@DinesafeTO", "http://twitter.com/DinesafeTO", :target => "_blank" %></li>
                <li><%= link_to "fb.com/DinesafeTO", "https://www.facebook.com/DinesafeTO", :target => "_blank" %></li>
                <li><%= link_to "Subscribe", "http://eepurl.com/vJgzb", :target => "_blank" %></li>
                <li><%= link_to "Privacy", privacy_path %></li>
                <li><%= link_to "Press", press_path %></li>
                <li><%= link_to "About", about_path %></li>
            </ul>

          <!-- END FOOTER -->
          </footer>
        </div>
    </div>

    <!-- LOAD SCRIPTS -->
    <script src="//ajax.googleapis.com/ajax/libs/jquery/1.8.0/jquery.min.js"></script>
